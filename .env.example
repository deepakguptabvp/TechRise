# TechRise Environment Variables Example
# Copy this file to .env.local and populate with your own keys when integrating backend services.

# Optional: Form Submission Provider (e.g. Web3Forms access key or Formspree endpoint)
# Web3Forms is 100% free and requires no backend (sign up at https://web3forms.com)
VITE_WEB3FORMS_ACCESS_KEY="your_web3forms_access_key_here"

# Optional: Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=""

# Business Info (Defaults are configured in src/data/siteConfig.js)
VITE_CONTACT_EMAIL="techrise.digitalservices@gmail.com"
VITE_CONTACT_PHONE="+919643080715"
